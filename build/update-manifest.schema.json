{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurutime.example/schemas/update-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "channel", "version", "publishedAt", "minimumMacOSVersion", "artifacts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "channel": { "enum": ["stable", "beta"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "minimumMacOSVersion": { "type": "string" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arch", "contentType", "file", "size", "sha256", "sha512", "url"],
            "properties": {
              "arch": { "const": "universal" },
              "contentType": { "const": "application/x-apple-diskimage" },
              "file": { "type": "string", "pattern": "-universal\\.dmg$" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sha512": { "type": "string" },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "value": { "type": "string" }
      }
    }
  }
}
