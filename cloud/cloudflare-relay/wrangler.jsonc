{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gurutime-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ENROLLMENT_LIMIT_PER_HOUR": "5",
    "PUBLIC_APP_ORIGIN": "https://app.example.com",
    "TURNSTILE_SITE_KEY": "replace-with-public-site-key"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "INSTALLATIONS", "class_name": "Installation" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Registry", "Installation"]
    }
  ]
}
